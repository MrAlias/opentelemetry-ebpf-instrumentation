{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:obi:apache-java-https:compatibility-cell-record-v1",
  "title": "Sealed Apache Java HTTPS compatibility cell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign",
    "campaign_revision",
    "plan_sha256",
    "cell_id",
    "status",
    "reason",
    "requested",
    "provider",
    "source",
    "runtime",
    "artifacts",
    "assertions",
    "evidence_index",
    "evidence"
  ],
  "properties": {
    "schema": {"const": "compatibility-cell-record-v1"},
    "campaign": {"enum": ["compatibility", "helper-lifecycle"]},
    "campaign_revision": {"type": "string"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "cell_id": {"$ref": "#/$defs/token"},
    "status": {"enum": ["pass", "fail", "unsupported", "untested"]},
    "reason": {"$ref": "#/$defs/token"},
    "requested": {"type": "object"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "registry_sha256", "external_driver", "launcher_sha256",
        "launcher_exit_status", "result_sha256", "command"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "external_driver": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sha256"],
              "properties": {
                "id": {"$ref": "#/$defs/token"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        },
        "launcher_sha256": {"$ref": "#/$defs/sha256"},
        "launcher_exit_status": {"type": "integer", "minimum": 0, "maximum": 255},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "command": {"type": "object"}
      }
    },
    "source": {"type": "object"},
    "runtime": {"type": ["object", "null"]},
    "artifacts": {"type": ["object", "null"]},
    "assertions": {"type": ["object", "null"]},
    "evidence_index": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "path", "sha256"],
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(runtime|artifacts|assertions)([.][A-Za-z0-9_-]+)+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$"
              },
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_manifest_sha256", "raw_manifest_sha256"],
      "properties": {
        "private_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "raw_manifest_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
    }
  }
}
