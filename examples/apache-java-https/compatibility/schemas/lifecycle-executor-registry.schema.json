{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:obi:apache-java-https:compatibility-lifecycle-executor-registry-v1",
  "title": "Source-approved helper lifecycle executors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "approved_executors"],
  "properties": {
    "schema": {"const": "compatibility-lifecycle-executor-registry-v1"},
    "approved_executors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "allowed_cell_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/token"},
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$"
          },
          "sha256": {"$ref": "#/$defs/sha256"},
          "allowed_cell_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "enum": [
                "h-jdk8-amd64-otel-getsockopt",
                "h-jdk11-amd64-otel-getsockopt",
                "h-jdk17-amd64-otel-getsockopt",
                "h-jdk21-amd64-otel-auto",
                "h-jdk21-amd64-otel-getsockopt",
                "h-jdk21-amd64-otel-unix",
                "h-jdk21-arm64-otel-getsockopt"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
    }
  }
}
