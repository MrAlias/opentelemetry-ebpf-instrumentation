{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentelemetry.io/schemas/obi-compatibility-source-authority-v1.json",
  "title": "OBI compatibility source authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "git_tree",
    "source_tree_sha256",
    "tracked_patch_sha256",
    "patch_identity_sha256"
  ],
  "properties": {
    "schema": {
      "const": "compatibility-source-authority-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "git_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tracked_patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
